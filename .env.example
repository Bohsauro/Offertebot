# Telegram Bot Token ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=inserisci_qui_il_tuo_token_bot

# Tuo ID Utente Telegram o ID del canale/gruppo in cui ricevere gli alert (es. 123456789)
# Puoi ottenerlo scrivendo a @userinfobot su Telegram
TELEGRAM_CHAT_ID=inserisci_qui_il_tuo_chat_id

# Frequenza di controllo offerte in minuti (default: 15)
CHECK_INTERVAL_MINUTES=15

# Voto minimo per inviare una notifica automatica (da 1.0 a 10.0, default: 7.0)
MIN_ALERT_SCORE=7.0

# Se true, esclude completamente dagli alert i prodotti con danni gravi/per ricambi
EXCLUDE_BROKEN=false

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
